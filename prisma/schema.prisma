// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String            @id @default(cuid())
  email       String            @unique
  name        String?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  application Application?
  draft       ApplicationDraft?

  @@map("users")
}

// Final, submitted application (one per student)
model Application {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                  String    @unique @map("user_id")
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email                   String    @unique
  fullName                String    @map("full_name")
  joinYear                Int       @map("join_year")
  yearOfStudy             Int       @map("year_of_study")
  department              String
  whatsapp                String    @default("")
  answers                 Json      @default("{}")
  links                   Json      @default("{}")
  status                  String    @default("SUBMITTED")
  statusNote              String?   @map("status_note")
  statusUpdatedAt         DateTime? @map("status_updated_at")
  reviewedBy              String?   @map("reviewed_by")
  interviewAt             DateTime? @map("interview_at")
  interviewMode           String?   @map("interview_mode")
  clarificationQuestion   String?   @map("clarification_question")
  clarificationAnswer     String?   @map("clarification_answer")
  clarificationAskedAt    DateTime? @map("clarification_asked_at")
  clarificationAnsweredAt DateTime? @map("clarification_answered_at")
  statusHistory           Json      @default("[]") @map("status_history")
  submittedAt             DateTime  @default(now()) @map("submitted_at")
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([department])
  @@index([status])
  @@map("applications")
}

// Outbox for status-change notifications. The PATCH admin route queues rows
// here; a worker (Resend / Supabase Edge Function / cron) drains the queue in
// production by claiming QUEUED rows and marking them SENT.
model StatusNotification {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String    @map("application_id")
  email         String
  fullName      String    @map("full_name")
  type          String    @default("STATUS_CHANGE")
  subject       String
  body          String
  channel       String    @default("email")
  status        String    @default("QUEUED")
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at")
  sentAt        DateTime? @map("sent_at")

  @@index([status])
  @@index([createdAt])
  @@map("status_notifications")
}

// Auto-saved in-progress form data so students never lose their answers
model ApplicationDraft {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  data      Json     @default("{}")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("application_drafts")
}

// Simple key/value runtime configuration (feature flags, toggles).
// Keys used today: "stats_public" = "0" | "1"
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("settings")
}
