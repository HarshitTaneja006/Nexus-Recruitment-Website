# ═══════════════════════════════════════════════════════════════════
#  NEXUS Recruitments '26 - environment template
#  cp .env.example .env   then fill in the values you need.
#  Every variable below is read somewhere in src/ - nothing speculative.
# ═══════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────
# Local SQLite (default, zero-setup):
DATABASE_URL="file:./db/custom.db"
# …or Supabase Postgres (Project Settings → Database → Connection string):
# DATABASE_URL="postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres"

# ── NextAuth (required) ───────────────────────────────────────────
# Secret: generate with  openssl rand -hex 32
NEXTAUTH_SECRET="replace-with-openssl-rand-hex-32"
# Canonical URL of the deployment (no trailing slash):
NEXTAUTH_URL="http://localhost:3000"

# ── Google OAuth (required for sign-in) ───────────────────────────
# Google Cloud Console → Credentials → OAuth 2.0 Client (Web application).
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Admin review console ──────────────────────────────────────────
# Comma-separated VIT emails that may access /review and its APIs.
ADMIN_EMAILS="core.nexus2023@vitstudent.ac.in"

# ── Public stats lock ─────────────────────────────────────────────
# /api/stats is sealed for non-admins until an admin unlocks it from
# the review console - the unlock dialog requires this secret.
STATS_LOCK_SECRET="replace-with-a-long-random-string"

# ── SMTP (email delivery via nodemailer) ──────────────────────────
# Without SMTP_HOST the outbox runs in SANDBOX mode (rows queued, never sent).
# With SMTP_HOST the drain worker delivers real mail through your relay:
# submission receipts, draft reminders and admin custom sends.
# SMTP_HOST="smtp.gmail.com"          # or in-v3.mailjet.com, smtp.office365.com, …
# SMTP_PORT=587                       # 587 STARTTLS (default) · 465 implicit TLS
# SMTP_SECURE=false                   # true for port 465
# SMTP_USER=""                        # omit for relays without auth
# SMTP_PASS=""
MAIL_FROM="NEXUS Recruitments <recruitment@nexusvit.in>"

# ── Supabase storage sync (optional) ──────────────────────────────
# Set all three to mirror applications into a Supabase table;
# leave blank to run on SQLite alone.
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""

# ── Public site URL (optional) ────────────────────────────────────
# Used for absolute OG/ICS links; falls back to the production domain.
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"
